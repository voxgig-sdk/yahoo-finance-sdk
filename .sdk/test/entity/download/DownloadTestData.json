            "schema": {
              "type": "string"
            }
          },
          {
            "description": "Start date as Unix timestamp",
            "in": "query",
            "name": "period1",
            "required": true,
            "schema": {
              "format": "int64",
              "type": "integer"
            }
          },
          {
            "description": "End date as Unix timestamp",
            "in": "query",
            "name": "period2",
            "required": true,
            "schema": {
              "format": "int64",
              "type": "integer"
            }
          },
          {
            "description": "Data interval",
            "in": "query",
            "name": "interval",
            "schema": {
              "default": "1d",
              "enum": [
                "1d",
                "1wk",
                "1mo"
              ],
              "type": "string"
            }
          },
          {
            "description": "Events to include",
            "in": "query",
