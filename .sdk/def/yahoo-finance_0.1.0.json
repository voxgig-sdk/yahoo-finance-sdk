          },
          "high": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "description": "High prices"
          },
          "low": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "description": "Low prices"
          },
          "close": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "description": "Closing prices"
          },
          "volume": {
            "type": "array",
            "items": {
              "type": "integer"
            },
            "description": "Trading volumes"
          }
        }
      }
    },
    "securitySchemes": {
      "cookieAuth": {
        "type": "apiKey",
        "in": "cookie",
        "name": "Session",
        "description": "Yahoo Finance uses cookie-based authentication for some endpoints"
      }
    }
  },
  "tags": [
    {
